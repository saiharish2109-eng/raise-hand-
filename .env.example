# Server Port
PORT=3000

# PostgreSQL / Neon Database Connection String
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Optional Individual PostgreSQL Parameters
# PGHOST=your-neon-host.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=your_password
# PGSSLMODE=require
